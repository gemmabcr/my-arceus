POSTGRES_PASSWORD=replace-with-a-local-password
APP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=30
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_PERIOD_SECONDS=60

# OAuth providers remain disabled while these values are empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Production Grafana. Keep real values only in the server .env file.
GRAFANA_ADMIN_USER=gemma
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-admin-password
GRAFANA_SECRET_KEY=replace-with-a-long-random-secret
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=replace-with-a-strong-read-only-password
